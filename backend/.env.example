# Cleanverse sandbox credentials (from the onboarding email) — never commit real values.
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# Chain + contract addresses (from contracts/script/DeployLocal.s.sol's console output for
# local dev, or the real Monad testnet deployment for production — see DECISIONS.md).
LEGATE_CHAIN=monad
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
LEGATE_ESCROW_ADDRESS=
AGENT_MANDATE_ADDRESS=
TRAVEL_RULE_ANCHOR_ADDRESS=
LEGATE_ATOKEN_ADDRESS=
CVI_REGISTRY_MIRROR_ADDRESS=

# Signers. RELAYER_PRIVATE_KEY submits x402 agent-payment transactions (single build-time
# relayer identity — see routes/x402.ts). ANCHOR_PRIVATE_KEY must hold ANCHOR_ROLE on
# TravelRuleAnchor; omit to disable the anchor-travel-rule endpoint.
RELAYER_PRIVATE_KEY=
ANCHOR_PRIVATE_KEY=

# Required (with ANCHOR_PRIVATE_KEY) to enable POST /api/payment/:id/anchor-travel-rule —
# that route spends real gas and a real Cleanverse API quota, so it requires this shared
# secret via the X-Admin-Key request header. Generate with e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=

# Optional: the revocation poller (Scene 3). Needs its own POLLER_ROLE key on
# CVIRegistryMirror (grant via mirror.grantPoller(...), or pass POLLER_ADDRESS to the deploy
# script). Without these two set, the backend still starts fine — Scene 3's proactive freeze
# just relies on the passive on-chain safety net (settlement independently re-verifies
# compliance regardless) instead of the active poller.
POLLER_PRIVATE_KEY=

PORT=4021
