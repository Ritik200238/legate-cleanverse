# Set NEXT_PUBLIC_CHAIN_MODE=local to point at a local Anvil deployment (see
# contracts/script/DeployLocal.s.sol), or omit it to use real Monad testnet.
NEXT_PUBLIC_CHAIN_MODE=local

# Leave empty to use the same-origin "/rpc" proxy (next.config.ts) to
# backend/test/browser-relay.ts — needed only when this app is reached through a
# tunnel that can't reach a bare RPC port directly (e.g. browser-automation testing).
# Set explicitly (e.g. https://testnet-rpc.monad.xyz) for a normal local/production run.
NEXT_PUBLIC_MONAD_RPC_URL=

# Leave empty for same-origin "/api" proxying (see next.config.ts rewrites) to the
# backend. Set explicitly (e.g. http://localhost:4021) if not using the proxy.
NEXT_PUBLIC_API_BASE_URL=

# Contract addresses — from contracts/script/DeployLocal.s.sol's console output for
# local dev, or from the real Monad testnet deployment (see DECISIONS.md).
NEXT_PUBLIC_ATOKEN_ADDRESS=

# A-Token decimals. Defaults to 18 (real Monad aUSDC as of 2026-08-08). Only set this if you
# are pointing at a token that differs — the app reads the token's real decimals() at runtime
# and shows a blocking warning if this value disagrees, so a wrong setting fails loudly rather
# than quietly mispricing every amount by orders of magnitude. See DECISIONS.md.
NEXT_PUBLIC_ATOKEN_DECIMALS=
NEXT_PUBLIC_LEGATE_ESCROW_ADDRESS=
NEXT_PUBLIC_AGENT_MANDATE_ADDRESS=
NEXT_PUBLIC_TRAVEL_RULE_ANCHOR_ADDRESS=
